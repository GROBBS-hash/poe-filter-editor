{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoE Filter Editor",
  "version": "0.2.29",
  "identifier": "com.grobbs.poefiltereditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PoE Lodestone",
        "decorations": false,
        "dragDropEnabled": false,
        "width": 1240,
        "height": 860,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Quick edit",
        "width": 300,
        "height": 470,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      },
      {
        "label": "build",
        "title": "Build",
        "width": 780,
        "height": 900,
        "minWidth": 420,
        "minHeight": 420,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false
      },
      {
        "label": "trade",
        "title": "Price check",
        "width": 380,
        "height": 560,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      },
      {
        "label": "trades",
        "title": "Trades",
        "width": 340,
        "height": 200,
        "x": 20,
        "y": 140,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "focus": false
      },
      {
        "label": "earnings",
        "title": "Earnings",
        "width": 230,
        "height": 120,
        "x": 1500,
        "y": 90,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "focus": false
      },
      {
        "label": "atlas",
        "title": "Atlas strategy",
        "width": 780,
        "height": 820,
        "minWidth": 420,
        "minHeight": 420,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "shadow": false,
        "focus": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzREEwMjhBN0I0MTNFRkMKUldUOFBrRjdpZ0xhSThVaVhjSDZsRlFnL0N1MmpZQUJVZzB5SzhxSzduVlYzS3h1cS9ZMytyUEQK",
      "endpoints": [
        "https://github.com/GROBBS-hash/poe-filter-editor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
