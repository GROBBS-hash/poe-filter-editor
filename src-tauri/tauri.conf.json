{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoE Filter Editor",
  "version": "0.1.0",
  "identifier": "com.grobbs.poefiltereditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PoE Filter Editor",
        "width": 820,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480
      },
      {
        "label": "overlay",
        "title": "Quick edit",
        "width": 300,
        "height": 470,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
